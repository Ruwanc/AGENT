# Copy this file to .env (same folder) and fill in the values.
# .env is in .gitignore: it must never be committed or pasted into a chat.

SERVICENOW_MODE=dry_run              # fake | dry_run | live   (switch to live after check_servicenow passes)

SN_INSTANCE=https://yourcompanydev.service-now.com
SN_AUTH=basic                        # basic | oauth
SN_USERNAME=svc_aws_account_agent
SN_PASSWORD=change-me
# SN_CLIENT_ID=                      # oauth only (System OAuth > Application Registry)
# SN_CLIENT_SECRET=

SN_API=catalog                       # catalog | table
SN_CATALOG_ITEM_SYS_ID=              # sys_id of the "AWS account request" catalog item
# SN_TABLE=incident                  # table mode only
# SN_TIMEOUT=30
