# systemd service for the CET Agent web UI (Streamlit), for RHEL 9.
#
# Layout (no SELinux exceptions needed):
#   /opt/cet-agent     the app (a copy of markdown-sources), owned by service user "cetagent"
#   /opt/cet-agent/.venv   its virtual environment, built from the Python in /opt/uv-python
#
# Install:
#   sudo cp /opt/cet-agent/deploy/cet-agent-ui.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cet-agent-ui
#
# Streamlit listens on 127.0.0.1:8501 only; nginx on port 80/443 forwards to it.

[Unit]
Description=CET Agent web UI (Streamlit)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=cetagent
Group=cetagent
# Project folder: config.py reads .env from here, Streamlit reads .streamlit/config.toml from here
WorkingDirectory=/opt/cet-agent
ExecStart=/opt/cet-agent/.venv/bin/streamlit run ui/chat_app.py \
    --server.headless true \
    --server.address 127.0.0.1 \
    --server.port 8501
# Same effect as `source .venv/bin/activate` (systemd runs no shell, so it can't `source`):
Environment=VIRTUAL_ENV=/opt/cet-agent/.venv
Environment=PATH=/opt/cet-agent/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/opt/cet-agent
Environment=PYTHONUNBUFFERED=1
# Optional overrides (otherwise taken from .env / config.py), e.g.:
# Environment=SERVICENOW_MODE=fake
# Environment=CHAT_MODEL=llama3.2:3b

Restart=on-failure
RestartSec=5

# Hardening: no privilege escalation, private /tmp, read-only /usr /boot /etc, no access to /home
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
